# ============================================
# BACKEND ENVIRONMENT VARIABLES (.env.example)
# Copy this to .env and fill in your actual credentials.
# DO NOT COMMIT THE .env FILE TO GIT.
# ============================================

# ============================================
# CLERK AUTHENTICATION (NEW - REQUIRED)
# ============================================
# Get your keys from https://dashboard.clerk.com/
# 1. Sign up for Clerk if you haven't already
# 2. Create an application
# 3. Go to API Keys section
# 4. Copy the Secret Key
CLERK_PUBLISHABLE_KEY="your_clerk_publishable_key"
CLERK_PUBLISH_KEY="your_clerk_publish_key"
CLERK_SECRET_KEY="your_clerk_secret_key"

# ============================================
# CORE DJANGO SETTINGS
# ============================================
# Set to False in production
DEBUG=True
# Generate a new secret key for production:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=dev-fallback-secret-key
# Comma-separated list of hosts. e.g., localhost,127.0.0.1,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,rediron-backend-1.onrender.com

# ============================================
# DATABASE
# ============================================
# Option 1: Neon/Render PostgreSQL URL. SSL is required automatically.
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"
# Option 2: Separate PostgreSQL variables. Used only when DATABASE_URL is empty.
DB_NAME=neondb
DB_USER=your-db-user
DB_PASSWORD=change-me
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_SSLMODE=require

# ============================================
# BREVO SMTP CONFIGURATION
# ============================================
# Use your real SMTP credentials in the local .env file only.
# Never commit these values to git.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

EMAIL_HOST_USER="your_smtp_username"
EMAIL_HOST_PASSWORD="your_smtp_password"

# Use an address verified inside Brevo. Many providers reject unverified From addresses in production.
EMAIL_FROM_ADDRESS=kvamsim7@gmail.com
DEFAULT_FROM_EMAIL=RedIron Gym <kvamsim7@gmail.com>
SERVER_EMAIL=RedIron Gym <kvamsim7@gmail.com>

ADMIN_EMAIL=kvamsim7@gmail.com
SUPPORT_EMAIL=kvamsim7@gmail.com
SITE_OWNER_EMAIL=kvamsim7@gmail.com
SHOP_ADMIN_EMAIL=kvamsim7@gmail.com

EMAIL_TIMEOUT=10

# ============================================
# JWT CONFIGURATION (COMMENTED OUT - Using Clerk tokens)
# ============================================
# Old JWT settings - NO LONGER USED
# Clerk tokens are used instead for authentication

# JWT_SECRET_KEY=your_secret_key
# JWT_ALGORITHM=HS256
# JWT_EXP_DELTA_SECONDS=3600

# ============================================
# RAZORPAY PAYMENT (Optional - if using payments)
# ============================================
# RAZORPAY_KEY_ID=your_razorpay_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ============================================
# SECURITY
# ============================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ============================================
# CORS SETTINGS
# ============================================
# Frontend/backend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://roaring-scone-cfda07.netlify.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://roaring-scone-cfda07.netlify.app,https://rediron-backend-1.onrender.com

# ============================================
# TIME ZONE
# ============================================
TIME_ZONE=UTC

# ============================================
# PAGINATION
# ============================================
PAGE_SIZE=10

# ============================================
# REDIRON COACH AI
# ============================================
# Keep provider API keys on the backend only. Never expose them to React.
COACH_AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-flash-latest,gemini-pro
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# ============================================
# LOGGING
# ============================================
DJANGO_LOG_LEVEL=INFO
