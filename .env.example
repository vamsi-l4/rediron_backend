# ============================================
# BACKEND ENVIRONMENT VARIABLES (.env.example)
# Copy this to .env and fill in your actual credentials.
# DO NOT COMMIT THE .env FILE TO GIT.
# ============================================

# ============================================
# CLERK AUTHENTICATION (NEW - REQUIRED)
# ============================================
# Get your keys from https://dashboard.clerk.com/
# 1. Sign up for Clerk if you haven't already
# 2. Create an application
# 3. Go to API Keys section
# 4. Copy the Secret Key
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
CLERK_PUBLISH_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# ============================================
# CORE DJANGO SETTINGS
# ============================================
# Set to False in production
DEBUG=True
# Generate a new secret key for production:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=dev-fallback-secret-key
# Comma-separated list of hosts. e.g., localhost,127.0.0.1,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,rediron-backend-1.onrender.com

# ============================================
# DATABASE
# ============================================
# Option 1: Neon/Render PostgreSQL URL. SSL is required automatically.
DATABASE_URL=postgresql://neondb_owner:npg_et0jVZaFsk8y@ep-tiny-star-atq6sby0-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Option 2: Separate PostgreSQL variables. Used only when DATABASE_URL is empty.
DB_NAME=neondb
DB_USER=your-db-user
DB_PASSWORD=change-me
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_SSLMODE=require

# ============================================
# EMAIL CONFIGURATION (COMMENTED OUT - Clerk handles emails)
# ============================================
# Old email service configuration - NO LONGER USED
# Clerk handles all email verification and notifications
# Keep these commented for backward compatibility during migration

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=your-email@example.com
EMAIL_TIMEOUT=10

# ============================================
# JWT CONFIGURATION (COMMENTED OUT - Using Clerk tokens)
# ============================================
# Old JWT settings - NO LONGER USED
# Clerk tokens are used instead for authentication

# JWT_SECRET_KEY=your_secret_key
# JWT_ALGORITHM=HS256
# JWT_EXP_DELTA_SECONDS=3600

# ============================================
# RAZORPAY PAYMENT (Optional - if using payments)
# ============================================
# RAZORPAY_KEY_ID=your_razorpay_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ============================================
# SECURITY
# ============================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ============================================
# CORS SETTINGS
# ============================================
# Frontend URL for development
CORS_TRUSTED_ORIGINS=http://localhost:3000,https://roaring-scone-cfda07.netlify.app

# ============================================
# TIME ZONE
# ============================================
TIME_ZONE=UTC

# ============================================
# PAGINATION
# ============================================
PAGE_SIZE=10

# ============================================
# LOGGING
# ============================================
DJANGO_LOG_LEVEL=INFO
