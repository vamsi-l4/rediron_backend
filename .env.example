# RedIron backend environment template
# Copy to .env for local development and fill values privately.
# Do not commit real credentials or production values.

# Core Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
PAGE_SIZE=10
DJANGO_LOG_LEVEL=INFO

# Database
DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Authentication
CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISH_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=

# Email notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM_ADDRESS=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
ADMIN_EMAIL=
SUPPORT_EMAIL=
SITE_OWNER_EMAIL=
SHOP_ADMIN_EMAIL=
EMAIL_TIMEOUT=10

# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
STATICFILES_STORAGE=whitenoise.storage.CompressedManifestStaticFilesStorage

# Legacy JWT configuration
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXP_DELTA_SECONDS=3600

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# RedIron Coach AI
COACH_AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
OPENAI_API_KEY=
OPENAI_MODEL=

# Data loading
LOAD_ALL_DATA=false
